@echo off
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo Запрашиваем права администратора...
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

echo Запуск от имени администратора выполнен.

call "%~dp0general.bat"

echo Ожидание 2 секунды перед удалением WinDivert...
timeout /t 2 /nobreak > nul

sc stop windivert > nul 2>&1
sc delete windivert > nul 2>&1

echo Готово!
pause
